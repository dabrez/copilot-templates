# --- Virtual environments ---
venv/
.venv/
env/
ENV/
.python-version

# --- Python bytecode / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Model caches (spaCy, HuggingFace, llama.cpp) ---
# This project downloads gemma-2-2b-it GGUF at runtime -- keep it out of git.
*.gguf
*.bin
*.safetensors
models/
.cache/
huggingface/

# --- Generated presentation output ---
# sample.pptx and the *_config.json examples are tracked on purpose;
# these are regenerated by `cli.py template` / `cli.py analyze`.
examples/auto_updated.pptx
examples/llm_updated.pptx
examples/updated_presentation.pptx
*_updated.pptx
~$*.pptx

# --- Secrets / local config ---
.env
.env.*
!.env.example
*.key
credentials.json

# --- Test & type-checker caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors & OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
